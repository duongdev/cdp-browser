#!/bin/sh
# Auto-planted by ~/.cyrus/hydrate-worktree.sh. Syncs local untracked context back to main on Done.
set -eu
WT="$PWD"
ROOT="$(dirname "$(git -C "$WT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")"
[ -x "$ROOT/.claude/scripts/conductor-sync.sh" ] && \
  CONDUCTOR_ROOT_PATH="$ROOT" CONDUCTOR_WORKSPACE_PATH="$WT" \
  sh "$ROOT/.claude/scripts/conductor-sync.sh" persist

# Post-merge hook: when this issue's branch actually landed, let the repo run whatever it needs on
# the refreshed base (e.g. reinstall the local build).
#
# Ask the forge, do not infer from git history. The old check was
# `merge-base --is-ancestor <tip> origin/<base>`, which is FALSE for a squash merge (squash writes a
# brand-new commit, so the branch tip never becomes an ancestor of main) — PSN-103 was squash-merged
# and silently skipped the rebuild. Earlier issues only "worked" because the base was resolved via
# `@{upstream}`, which returns origin/<the-same-branch>, making the ancestry test vacuously true.
# `gh pr list --state merged` is exact for squash, rebase, and merge-commit alike, and yields the
# real base branch. Safe here: this block is already guarded to cdp-browser, which is GitHub.
BR="$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null)"
BASE="$(cd "$ROOT" && gh pr list --head "$BR" --state merged --limit 1 --json baseRefName -q '.[0].baseRefName' 2>/dev/null)"
if [ -x "$ROOT/.claude/scripts/ade-post-merge.sh" ] && [ -n "$BR" ] && [ "$(basename "$ROOT")" = "cdp-browser" ]; then
  if [ -n "$BASE" ]; then
    echo "branch merged into $BASE — launching ade-post-merge.sh (detached)"
    # DETACHED: ade-post-merge may run a full deps-install + local build (minutes). Cyrus awaits
    # teardown, and heavy synchronous work here starves the daemon's event loop (/status times out,
    # sessions stall). nohup + background + disown lets teardown return instantly while the rebuild
    # runs on its own, logged to .claude/post-merge.log.
    ADE_MERGED_BRANCH="$BR" ADE_BASE_BRANCH="$BASE" \
      nohup sh "$ROOT/.claude/scripts/ade-post-merge.sh" >> "$ROOT/.claude/post-merge.log" 2>&1 &
    disown 2>/dev/null || true
  fi
fi
