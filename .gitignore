node_modules
dist
dist-chat
release
release-chat

# Web build runtime state (default paths write to repo root; override via env)
web-settings.json
web-notifications.json
web-history.json

# Teams chat store (server-owned SQLite; default path writes to repo root)
web-teams.db
web-teams.db-shm
web-teams.db-wal

# BFF chat store (apps/chat-server SQLite; dev/test runs write to repo root)
chat.db
chat.db-shm
chat.db-wal

# Local mock stack state (pnpm chat:mock — chat.db, web settings, Electron userData; wiped on boot)
.mock-data*/

# Baked build identity (Docker builder writes it; never committed)
.gitsha

# Agent worktrees (transient, never commit)
.claude/worktrees/

# Scheduled-task lock (transient, never commit)
.claude/scheduled_tasks.lock

# E2E run artifacts
test-results/
test/e2e/playwright-results.json
playwright-report/

# Visual-review scratch (screenshots).
# No trailing slash: with `.scratch/` git only ignores a DIRECTORY, so the symlink that
# e2e-link-worktree.sh drops here was tracked instead of ignored — and it pointed at
# itself, which stopped electron-builder dead (`ELOOP: too many symbolic links`).
.scratch

# Web build runtime state (Slack workspace registry + push subscriptions + sweep watermark)
slack-workspaces.json
slack-sweep-state.json
web-push-subs.json
teams-push-subs.json
teams-notify-state.json

# Verification screenshots (evidence lives in the PR/issue, not the repo)
.shots/

# regression/QA screenshot artifacts
.reg/
.tmp-reg/
*.pre-3way.bak
